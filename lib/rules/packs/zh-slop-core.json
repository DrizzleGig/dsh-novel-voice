    {
      "id": "ZH026",
      "type": "DEFINITIONAL_OPENING",
      "scope": "narration",
      "severity": "warn",
      "match": {
        "kind": "regex",
        "pattern": "^(?:在.*?的背景下|在.*?领域中|在.*?世界里)，",
        "flags": "u"
      },
      "message": "定义式开头：先给大背景再进正文",
      "fix": "从具体场景、人物或动作开头。",
      "evidenceLevel": "indirect"
    },
    {
      "id": "ZH027",
      "type": "STRUCTURAL_CLICHE",
      "scope": "narration",
      "severity": "warn",
      "match": {
        "kind": "regex",
        "pattern": "不仅[\\s\\S]{0,100}?而且",
        "flags": "u"
      },
      "message": "结构套式：不仅…而且…",
      "fix": "拆成两个具体事实，不用固定搭配。",
      "evidenceLevel": "indirect"
    }
