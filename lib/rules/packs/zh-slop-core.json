  "defaultEnabled": false,
  "rules": [
    {
      "id": "ZH028",
      "type": "NOT_X_BUT_Y",
      "scope": "narration",
      "severity": "warn",
      "match": {
        "kind": "regex",
        "pattern": "不仅是[^。！？]{1,40}，?更是",
        "flags": "u"
      },
      "message": "否定-修正句：先否定一个并不存在的说法，再抬高后半句",
      "fix": "直接说主张；只有否定半边在纠正读者实际认知时才保留。",
      "evidenceLevel": "indirect"
    },
    {
      "id": "ZH001",
      "type": "SLOP_PHRASE",
      "scope": "all",
      "severity": "warn",
      "match": {
        "kind": "phrase",
        "pattern": "在当今快节奏的世界中"
      },
      "message": "套话/空泛短语",
      "fix": "删掉，或换成具体事实、人物或动作。",
      "evidenceLevel": "direct"
    },
    {
      "id": "ZH002",
      "type": "SLOP_PHRASE",
      "scope": "all",
      "severity": "warn",
