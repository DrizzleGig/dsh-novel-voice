{
  "id": "zh-slop-core",
  "title": "中文套话与结构陈词（humanizer-lint 子集）",
  "version": "1.0.0",
  "license": "MIT",
  "source": {
    "project": "humanizer-lint",
    "version": "1.6.0",
    "url": "https://github.com/yanstd888/humanizer-lint",
    "license": "MIT"
